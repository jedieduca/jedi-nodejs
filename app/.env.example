# URL base da API
REACT_APP_API_URL=http://localhost:8000/api

# Chave de API (se necessário)
REACT_APP_API_KEY=your_api_key_here

# Chaves API para modelos LLM
REACT_APP_OPENAI_API_KEY=your_openai_api_key_here
REACT_APP_GOOGLE_API_KEY=your_google_api_key_here
REACT_APP_DEEPSEEK_API_KEY=your_deepseek_api_key_here
REACT_APP_ANTHROPIC_API_KEY=your_anthropic_api_key_here
REACT_APP_OLLAMA_API_KEY=your_ollama_api_key_here

# Configurações do PostgreSQL (apenas para referência - usadas no backend)
# REACT_APP_PG_HOST=localhost
# REACT_APP_PG_PORT=5432
# REACT_APP_PG_DATABASE=your_database
# REACT_APP_PG_USER=your_user
# REACT_APP_PG_PASSWORD=your_password

# Ambiente
NODE_ENV=development 